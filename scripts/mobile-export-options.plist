<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Flutter(apps/mobile) App Store 내보내기 옵션 — release.yml release-ios가 쓴다.
	     apps/mobile/ios/ 가 아니라 여기(scripts/)에 두는 이유: BRU-160이 같은 시기에
	     apps/mobile/ios/ 아래 공유 확장·위젯 타깃을 작업 중이라 그 트리를 건드리지
	     않기 위해서다. 위치를 옮기려면 release.yml의 경로도 함께 바꿔야 한다. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>J2Y925QHNV</string>
	<key>signingStyle</key>
	<string>manual</string>
	<!-- 프로파일 이름은 Apple Developer 포털의 것과 정확히 같아야 한다.
	     번들 ID가 네이티브 앱과 동일(com.intellieffect.drop.mobile)하므로
	     기존 프로파일(DROP Native App Store)을 그대로 쓴다.
	     공유 확장·위젯 매핑(BRU-160): 번들 ID·App Group이 apps/ios 확장과 같아
	     apps/ios/ExportOptions.plist 의 프로파일을 그대로 쓴다. 확장 매핑이
	     빠지면 appex가 entitlements 없이 서명되어 업로드가 409로 막힌다 (BRU-58).
	     release.yml 쪽 프로파일 시크릿 임포트는 BRU-161 트랙이 잇는다. -->
	<key>provisioningProfiles</key>
	<dict>
		<key>com.intellieffect.drop.mobile</key>
		<string>DROP Native App Store</string>
		<key>com.intellieffect.drop.mobile.share</key>
		<string>DROP Native Share App Store</string>
		<key>com.intellieffect.drop.mobile.widget</key>
		<string>DROP-Widget-Provisioning-Profile</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
