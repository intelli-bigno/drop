<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DropApplication"
        android:allowBackup="false"
        android:label="DROP"
        android:supportsRtl="true"
        android:theme="@style/Theme.Drop">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="DROP"
            android:theme="@style/Theme.Drop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          다른 앱의 "공유"에 DROP을 띄운다 (iOS DropShare 대응).
          화면 없이 담고 토스트만 띄우므로 테마를 투명하게 둔다 — 흰 화면이 깜빡이지 않게.
        -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:label="DROP에 담기"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!--
          홈 화면 위젯 (BRU-68). receiver와 meta-data 둘 다 있어야 위젯 갤러리에 뜬다 —
          iOS BRU-35가 정확히 "갤러리에 안 보인다"였고 원인은 타깃 누락이었다.
        -->
        <receiver
            android:name=".DropWidgetReceiver"
            android:exported="true"
            android:label="DROP">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/drop_widget_info" />
        </receiver>
    </application>

</manifest>
