# 이 파일을 local.properties 로 복사하거나 `make android-config` 를 쓴다.
# 실제 값이 든 local.properties 는 커밋되지 않는다.

# Android SDK 경로 (ANDROID_HOME 이 export 돼 있으면 없어도 된다)
#sdk.dir=/Users/<you>/Library/Android/sdk

# 에뮬레이터에서 호스트의 로컬 Supabase 는 10.0.2.2 로 보인다.
SUPABASE_URL=http://10.0.2.2:58321
SUPABASE_ANON_KEY=

# Google 로그인의 serverClientId — **웹** 클라이언트 ID여야 한다.
# 비밀값이 아니다(APK 안에 그대로 실린다). 비우면 앱이 시작 시점에 구성 오류로 멈춘다.
GOOGLE_WEB_CLIENT_ID=627053596385-pn1ba7kvg7rcfhesr532qtdc19vnqf5m.apps.googleusercontent.com
