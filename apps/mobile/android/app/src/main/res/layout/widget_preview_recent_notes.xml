<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯 고르는 화면의 미리보기 (BRU-189). 실제 위젯은 스냅샷 파일을 읽어 그리는데,
  고르는 화면에서는 그 파일을 읽지 않아 "아직 노트가 없습니다"만 보인다(에뮬레이터 실측)
  — iOS 위젯의 `RecentNotesEntry.placeholder`와 같은 이유로 예시 두 줄을 보여 준다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_surface"
    android:padding="@dimen/drop_space_x3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_brand"
            android:textColor="@color/drop_text_secondary"
            android:textSize="@dimen/drop_text_xs"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/widget_compose_title"
            android:src="@drawable/ic_widget_compose" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/drop_space_x2"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/widget_preview_note_first"
        android:textColor="@color/drop_text_primary"
        android:textSize="@dimen/drop_text_sm" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_time_first"
        android:textColor="@color/drop_text_tertiary"
        android:textSize="@dimen/drop_text_xs" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/drop_space_x2"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/widget_preview_note_second"
        android:textColor="@color/drop_text_primary"
        android:textSize="@dimen/drop_text_sm" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_time_second"
        android:textColor="@color/drop_text_tertiary"
        android:textSize="@dimen/drop_text_xs" />
</LinearLayout>
