<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>J2Y925QHNV</string>
	<key>signingStyle</key>
	<string>manual</string>
	<!-- 앱과 확장 각각의 프로파일이 필요하다. 이름은 Apple Developer 포털에서
	     프로파일을 만들 때 붙인 것과 정확히 같아야 한다. -->
	<key>provisioningProfiles</key>
	<dict>
		<key>com.intellieffect.drop.mobile</key>
		<string>DROP Native App Store</string>
		<key>com.intellieffect.drop.mobile.share</key>
		<string>DROP Native Share App Store</string>
		<!-- 위젯은 BRU-35에서 추가됐는데 이 매핑이 빠져 있었다. 그 결과 위젯 appex가
		     entitlements 없이 서명되어 TestFlight 업로드가 409로 막혔다 (BRU-58).
		     Flutter 시절 위젯과 번들 ID·App Group이 같아 그때 프로파일을 그대로 쓴다. -->
		<key>com.intellieffect.drop.mobile.widget</key>
		<string>DROP-Widget-Provisioning-Profile</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
