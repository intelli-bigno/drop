// 리모트(운영) Supabase로 붙는 구성. 사용법은 Config-localdev.xcconfig.example과 같다.
//
//   cp Config/Config-remote.xcconfig.example Config/Config-remote.xcconfig
//   # 또는: export SUPABASE_URL_REMOTE=... SUPABASE_ANON_KEY_REMOTE=... && make ios-config
//
// TestFlight/배포 빌드는 이 구성을 쓴다.

DROP_ENVIRONMENT = remote

SUPABASE_URL = https:/$()/여기에-프로젝트-ref.supabase.co
SUPABASE_ANON_KEY = 여기에-리모트-anon-key를-넣는다

// serverClientId 에는 반드시 **웹** 클라이언트 ID를 넣는다.
// iOS 것을 넣으면 id_token 의 audience 가 어긋나 Supabase 가 Unacceptable audience 로 거부한다.
// 두 클라이언트는 같은 GCP 프로젝트(bruce-clawdbot)에 있어야 한다.
GOOGLE_WEB_CLIENT_ID = 여기에-웹-클라이언트-ID.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID = 여기에-iOS-클라이언트-ID.apps.googleusercontent.com

// 위 iOS 클라이언트 ID를 뒤집은 값 (Google 로그인 콜백 URL 스킴)
GOOGLE_IOS_CLIENT_ID_REVERSED = com.googleusercontent.apps.여기에-iOS-클라이언트-ID
