# 로컬 Supabase를 보는 데스크톱 개발 구성. 이 파일을 .example 없이 복사해 쓴다:
#
#   cp apps/desktop/.env.localdev.example apps/desktop/.env.localdev
#
# 값은 `supabase start`가 출력하는 것과 같다. anon key는 모든 로컬 스택이 공유하는
# 고정값이라 비밀이 아니다 — 리모트 키를 여기에 넣지 말 것.

VITE_SUPABASE_URL=http://127.0.0.1:58321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# 1이면 로그인 화면을 건너뛰고 시드 사용자(preview@drop.local)로 들어간다 (BRU-71).
# 개발 빌드에서만 동작한다 — 프로덕션 번들에는 이 경로 자체가 없다.
# 먼저 `supabase db reset`으로 시드를 넣어 둬야 한다.
VITE_DROP_PREVIEW=1
